  "qid": 357,
  "db": "superhero",
  "question": "What is the average weight, in kg, of the heroes who belong to races in which no hero is female? Heroes whose weight is not recorded should not count toward the average. I just need that single value.",
  "evidence": "female: the hero's gender is female",
  "referenceSql": "SELECT AVG(T1.weight_kg) AS average_weight_kg FROM superhero AS T1 INNER JOIN race AS T2 ON T1.race_id = T2.id WHERE T1.weight_kg > 0 AND NOT EXISTS (SELECT 1 FROM superhero AS T3 INNER JOIN gender AS T4 ON T3.gender_id = T4.id WHERE T3.race_id = T2.id AND T4.gender = 'Female')",
